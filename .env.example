# ───────── ApiSmartPulse local configuration ─────────
# Copy to .env and replace every <…> value. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 48
#                    or:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Services refuse to start while a secret still contains a placeholder such as <…> or change-me.
APP_ENV=local
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Database (local Docker defaults). For a Neon branch, generate .env.neon with scripts/make-neon-env.sh
# (verify-full TLS URLs + role passwords) and start with docker-compose.neon.yml; see README.
POSTGRES_DB=apismartpulse
POSTGRES_SUPERUSER_PASSWORD=<generate-strong-password>
DB_OWNER_USER=asp_owner
DB_OWNER_PASSWORD=<generate-strong-password>
DB_APP_USER=asp_app
DB_APP_PASSWORD=<generate-strong-password>
DB_AI_USER=asp_ai
DB_AI_PASSWORD=<generate-strong-password>
JDBC_DATABASE_URL=jdbc:postgresql://db:5432/apismartpulse
AI_DATABASE_URL=postgresql://db:5432/apismartpulse

# Host ports (change only if something else already uses them; keep VITE_API_BASE_URL and
# CORS_ALLOWED_ORIGINS in sync with the backend/frontend ports)
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=8081

# Auth
# AUTH_PROVIDER: local (built-in email/password, default; CI and offline dev) | neon (Neon Auth:
# email/password + Google, managed by Neon). Neon values are public URLs, not secrets, and usually
# come from .env.neon. VITE_* are baked into the frontend build.
AUTH_PROVIDER=local
NEON_AUTH_URL=
NEON_AUTH_ORIGIN=
VITE_AUTH_PROVIDER=local
VITE_NEON_AUTH_URL=
JWT_SECRET=<openssl rand -base64 48>
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Service-to-service
INTERNAL_SERVICE_TOKEN=<openssl rand -base64 48>
AI_SERVICE_URL=http://ai-service:8000

# Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
VITE_API_BASE_URL=http://localhost:8080
SPRINGDOC_ENABLED=true

# Limits
PUBLIC_API_RATE_PER_MINUTE=100
AI_USER_LIMIT_PER_10MIN=5
SPLIT_MIN_HOURS=16
VITE_SPLIT_MIN_HOURS=16

# AI service
# EMBEDDINGS_BACKEND: local (sentence-transformers, downloads ~90 MB once) | fake (deterministic, tests only)
EMBEDDINGS_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DUPLICATE_THRESHOLD=0.85
ML_MIN_TRAINING_ROWS=50
# LLM_PROVIDER: none (degraded, default) | mock (tests) | groq (free plan, needs GROQ_API_KEY)
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=15
LLM_MAX_CALLS_PER_MINUTE=3
LLM_DAILY_TOKEN_BUDGET=180000

# Seed (local only)
SEED_ADMIN_EMAIL=admin@demo.local
SEED_DEMO_PASSWORD=<choose-a-demo-password-min-10-chars>
